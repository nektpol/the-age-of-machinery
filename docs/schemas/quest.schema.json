{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/the-age-of-machinery/schemas/quest.schema.json",
  "title": "The Age of Machinery - Quest Definition v1",
  "description": "Authoring-time schema for vanilla and Create objectives. Crafting requires ingredient metadata; kinetic activation may include a first-use machine-build checklist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "title",
    "description",
    "objectives",
    "rewards"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/resourceId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "rewards": {
      "$ref": "#/$defs/rewards"
    }
  },
  "$defs": {
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9_./-]+$",
      "minLength": 1
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "MANUAL"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "item"
          ],
          "properties": {
            "type": {
              "enum": [
                "CRAFT_ITEM",
                "PICKUP_ITEM"
              ]
            },
            "item": {
              "$ref": "#/$defs/resourceId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "machine",
            "minSpeed"
          ],
          "properties": {
            "type": {
              "const": "KINETIC_ACTIVE"
            },
            "machine": {
              "$ref": "#/$defs/resourceId"
            },
            "minSpeed": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "machine",
            "output"
          ],
          "properties": {
            "type": {
              "const": "MACHINE_PROCESS"
            },
            "machine": {
              "$ref": "#/$defs/resourceId"
            },
            "output": {
              "$ref": "#/$defs/resourceId"
            }
          }
        }
      ]
    },
    "ingredient": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "amount"
          ],
          "properties": {
            "item": {
              "$ref": "#/$defs/resourceId"
            },
            "amount": {
              "$ref": "#/$defs/positiveInt"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "amount"
          ],
          "properties": {
            "tag": {
              "$ref": "#/$defs/resourceId"
            },
            "amount": {
              "$ref": "#/$defs/positiveInt"
            }
          }
        }
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "requiredAmount",
        "optional",
        "trigger"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "requiredAmount": {
          "$ref": "#/$defs/positiveInt"
        },
        "optional": {
          "type": "boolean"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "trigger": {
                "properties": {
                  "type": {
                    "const": "CRAFT_ITEM"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "trigger"
            ]
          },
          "then": {
            "required": [
              "ingredients"
            ]
          },
          "else": {
            "if": {
              "properties": {
                "trigger": {
                  "properties": {
                    "type": {
                      "const": "KINETIC_ACTIVE"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              },
              "required": [
                "trigger"
              ]
            },
            "then": {},
            "else": {
              "not": {
                "required": [
                  "ingredients"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trigger": {
                "properties": {
                  "type": {
                    "const": "KINETIC_ACTIVE"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "trigger"
            ]
          },
          "then": {
            "properties": {
              "requiredAmount": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "reward": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "amount"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/localId"
            },
            "type": {
              "const": "EXPERIENCE"
            },
            "amount": {
              "$ref": "#/$defs/positiveInt"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "item",
            "amount"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/localId"
            },
            "type": {
              "const": "ITEM"
            },
            "item": {
              "$ref": "#/$defs/resourceId"
            },
            "amount": {
              "$ref": "#/$defs/positiveInt"
            }
          }
        }
      ]
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main"
      ],
      "properties": {
        "main": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reward"
          }
        },
        "optional": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/localId"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reward"
            }
          }
        }
      }
    }
  }
}
